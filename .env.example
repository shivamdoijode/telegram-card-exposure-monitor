# Copy this file to .env and fill in your own values. Never commit .env.
# Get API_ID and API_HASH at https://my.telegram.org > API development tools
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here
TG_PHONE=+911234567890
# Any random text. Keep it the same between runs so dedupe stays consistent.
CARD_HASH_SALT=change_me_to_a_random_string
